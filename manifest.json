{
  "manifest_version": 3,
  "name": "Gemini Pro Tools",
  "version": "1.3.1",
  "author": "Shayan Farhang Pazhooh (shayanfp.ir)",
  "homepage_url": "https://github.com/shayanfp",
  "description": "ابزارهایی برای حرفه‌ای‌ها در Gemini: کپی دقیق، کتابخانه پرامپت، و اعلان صوتی در پایان پردازش.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "js/settings_custom.js",
        "lib/marked.min.js",
        "lib/dompurify.min.js",
        "lib/highlight.min.js",
        "js/library_common.js",
        "js/content.js"
      ],
      "css": [
        "css/library.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}